# Copy to .env and fill in (never commit .env — repo root .gitignore covers it).
#
# Google AI Studio: https://aistudio.google.com/apikey

# Primary — accepted by analysis_a_llm_clusters.py (either name works)
GOOGLE_API_KEY=

# Fallback when primary hits daily free-tier quota (auto-rotated by the script)
GOOGLE_API_KEY_2=

# Optional aliases (same values as above if you prefer)
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=

# Override model without editing llm_judge_models.yaml (optional)
# GEMINI_MODEL=gemini-3.1-flash-lite

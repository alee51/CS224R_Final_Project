+@register_adv_est(AdvantageEstimator.MINORITY_COT)
+def compute_minority_cot_outcome_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    epsilon: float = 1e-6,
+    norm_adv_by_std_in_grpo: str = True,
+    config=None,
+    **kwargs,
+):
+    """Minority-CoT set-based marginal advantage estimator.
+
+    Registered as ``AdvantageEstimator.MINORITY_COT = "minority_cot"``.
+    Invoked when ``algorithm.adv_estimator: minority_cot`` is set in Hydra.
+
+    Cluster-source selection via ``config.algorithm.minority_cot.cluster_source``:
+    ``mock`` (Stage 3a, deterministic hash) or ``judge`` (Stage 3b, real
+    LLM judge). All routing logic lives in
+    ``train.objective_minority.assign_clusters_for_minority_cot_hook`` so this
+    patch surface stays minimal.
+
+    For ``cluster_source=judge``, the ray_trainer dispatch must pass ``data``
+    in kwargs - see ``infra/patches/maxrl_expose_data_to_adv_est.patch``.
+
+    Returns
+    -------
+    (advantages, advantages) : tuple[torch.Tensor, torch.Tensor]
+        Both tensors have shape ``[batch, response_length]``.  Returns the same
+        tensor twice following the ``(advantages, returns)`` convention of the
+        other outcome-advantage estimators in this file.
+    """
+    # main-verl is on PYTHONPATH inside the Modal container (set in modal_image.py).
+    from train.objective_minority import (
+        N_ROLLOUTS,
+        _group_rewards_by_index,
+        _minority_advantages,
+        _scatter_advantages_to_tokens,
+        assign_clusters_for_minority_cot_hook,
+    )
+
+    global_seed = 0
+    if config is not None:
+        mc = getattr(getattr(config, "algorithm", None), "minority_cot", None)
+        if mc is not None:
+            global_seed = int(getattr(mc, "global_seed", global_seed))
+
+    with torch.no_grad():
+        # Group per-token rewards -> per-rollout scalars grouped by prompt.
+        rewards_grouped, problem_ids = _group_rewards_by_index(
+            token_level_rewards, response_mask, index, n_rollouts=N_ROLLOUTS
+        )
+
+        # Route to mock or judge cluster source based on Hydra config.
+        asg = assign_clusters_for_minority_cot_hook(
+            problem_ids=problem_ids,
+            n_rollouts=N_ROLLOUTS,
+            config=config,
+            data=kwargs.get("data"),
+        )
+
+        # Compute marginal advantages via the minority-CoT kernel.
+        adv_out = _minority_advantages(
+            rewards_grouped, asg.cluster_ids,
+            global_seed=global_seed, problem_ids=problem_ids,
+        )
+
+        # Broadcast [n_prompts, n_rollouts] -> [batch, response_length].
+        token_adv = _scatter_advantages_to_tokens(
+            adv_out.advantages, index, response_mask
+        )
+
+    return token_adv, token_adv

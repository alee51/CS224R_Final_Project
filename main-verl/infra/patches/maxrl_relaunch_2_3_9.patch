From fb1cad9b18738bf0530aa1c878e3926427822cce Mon Sep 17 00:00:00 2001
From: Nancy <nancy.x.bao@gmail.com>
Date: Sun, 31 May 2026 17:08:47 -0700
Subject: [PATCH 2/3] cs224r: force final-step ckpt as permanent (relaunch #1)

---
 verl/trainer/ppo/ray_trainer.py | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/verl/trainer/ppo/ray_trainer.py b/verl/trainer/ppo/ray_trainer.py
index 033e436..79a1e58 100644
--- a/verl/trainer/ppo/ray_trainer.py
+++ b/verl/trainer/ppo/ray_trainer.py
@@ -1464,13 +1464,21 @@ class RayPPOTrainer:
         else:
             critic_remote_path = None
 
+        # cs224r relaunch #1: the final training step must always be kept and
+        # treated as permanent — `save_freq: 10` with `total_training_steps`
+        # not divisible by 10 (e.g. 1-epoch flag → ~397) would otherwise prune
+        # the actually-trained model. The fit() gate at the save_freq check
+        # site has `is_last_step or …`; here we mirror it so the checkpoint is
+        # also tagged permanent and the temp-ckpt pruning at the bottom of this
+        # function leaves it on disk.
+        is_final_step = (self.global_steps == self.total_training_steps)
         permanent_ckpt_freq = self.config.trainer.get("permanent_ckpt_freq", None)
         if permanent_ckpt_freq is not None and permanent_ckpt_freq > 0:
-            is_permanent = (self.global_steps % permanent_ckpt_freq == 0)
+            is_permanent = (self.global_steps % permanent_ckpt_freq == 0) or is_final_step
             max_actor_ckpt_to_keep = None
             max_critic_ckpt_to_keep = None
         else:
-            is_permanent = False
+            is_permanent = is_final_step
             remove_previous_ckpt_in_save = self.config.trainer.get("remove_previous_ckpt_in_save", False)
             if remove_previous_ckpt_in_save:
                 print("Warning: remove_previous_ckpt_in_save is deprecated," + " set max_actor_ckpt_to_keep=1 and max_critic_ckpt_to_keep=1 instead")
-- 

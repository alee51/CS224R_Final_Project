Subject: [PATCH 1/3] cs224r: per-rollout JSONL + GRPO W&B parity (relaunch
 #2/#3/#9)

---
 verl/trainer/ppo/core_algos.py  | 10 ++++++++--
 verl/trainer/ppo/ray_trainer.py | 22 ++++++++++++++++++++++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/verl/trainer/ppo/core_algos.py b/verl/trainer/ppo/core_algos.py
index e3c495b..fd92203 100644
--- a/verl/trainer/ppo/core_algos.py
+++ b/verl/trainer/ppo/core_algos.py
@@ -515,8 +515,11 @@ def compute_minority_cot_outcome_advantage(
         # Stage 7: forward per-step diagnostics to W&B via batch.meta_info.
         if (data := kwargs.get("data")) is not None:
             from train.objective_minority import _build_step_metrics
+            # cs224r relaunch #2 / #3: pass `data` so _build_step_metrics can
+            # join finish_reasons + response_mask and write per-rollout JSONL.
             data.meta_info["cs224r_metrics"] = _build_step_metrics(
-                rewards_grouped, problem_ids, adv_out.diagnostics, asg.diagnostics
+                rewards_grouped, problem_ids, adv_out.diagnostics, asg.diagnostics,
+                data=data,
             )
 
         # Broadcast [n_prompts, n_rollouts] -> [batch, response_length].
@@ -581,8 +584,11 @@ def compute_poly_epo_cot_outcome_advantage(
         # Stage 7: forward per-step diagnostics to W&B via batch.meta_info.
         if (data := kwargs.get("data")) is not None:
             from train.objective_minority import _build_step_metrics
+            # cs224r relaunch #2 / #3: pass `data` so _build_step_metrics can
+            # join finish_reasons + response_mask and write per-rollout JSONL.
             data.meta_info["cs224r_metrics"] = _build_step_metrics(
-                rewards_grouped, problem_ids, adv_out.diagnostics, asg.diagnostics
+                rewards_grouped, problem_ids, adv_out.diagnostics, asg.diagnostics,
+                data=data,
             )
 
         token_adv = _scatter_advantages_to_tokens(
diff --git a/verl/trainer/ppo/ray_trainer.py b/verl/trainer/ppo/ray_trainer.py
index 391f87b..033e436 100644
--- a/verl/trainer/ppo/ray_trainer.py
+++ b/verl/trainer/ppo/ray_trainer.py
@@ -267,6 +267,24 @@ def compute_advantage(
         )
         data.batch["advantages"] = advantages
         data.batch["returns"] = returns
+
+        # cs224r relaunch #9: GRPO W&B parity — populate train/pass_at_8,
+        # train/prompts_unlocked, train/fraction_filtered (and #2/#3 hooks)
+        # via the same batch.meta_info["cs224r_metrics"] channel the set arms use.
+        try:
+            from train.objective_minority import _build_grpo_step_metrics
+            data.meta_info["cs224r_metrics"] = _build_grpo_step_metrics(
+                token_level_rewards=data.batch["token_level_rewards"],
+                response_mask=grpo_calculation_mask,
+                index=data.non_tensor_batch["uid"],
+                data=data,
+            )
+        except Exception as _cs224r_exc:
+            # Never let metrics emission break the training step.
+            import logging as _lg
+            _lg.getLogger(__name__).warning(
+                "cs224r GRPO metrics emit failed: %s", _cs224r_exc,
+            )
         
     elif adv_estimator == AdvantageEstimator.MAXRL:
         # Initialize the mask for GRPO calculation
@@ -1844,6 +1862,10 @@ class RayPPOTrainer:
 
                         norm_adv_by_std_in_grpo = self.config.algorithm.get("norm_adv_by_std_in_grpo", True)  # GRPO adv normalization factor
 
+                        # cs224r relaunch #2: expose global_steps to advantage hooks
+                        # so the per-rollout JSONL writer can partition by step.
+                        batch.meta_info["global_steps"] = self.global_steps
+
                         batch = compute_advantage(
                             batch,
                             adv_estimator=self.config.algorithm.adv_estimator,

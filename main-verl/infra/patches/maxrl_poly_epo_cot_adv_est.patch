+@register_adv_est(AdvantageEstimator.POLY_EPO_COT)
+def compute_poly_epo_cot_outcome_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    epsilon: float = 1e-6,
+    norm_adv_by_std_in_grpo: str = True,
+    config=None,
+    **kwargs,
+):
+    """Poly-EPO-CoT set-based marginal advantage estimator.
+
+    Registered as ``AdvantageEstimator.POLY_EPO_COT = "poly_epo_cot"``. Invoked
+    when ``algorithm.adv_estimator: poly_epo_cot`` is set in Hydra.
+
+    Cluster-source selection via ``config.algorithm.poly_epo_cot.cluster_source``:
+    ``mock`` or ``judge``. Same routing pattern as minority_cot but reads the
+    poly_epo_cot Hydra block; ships its own
+    ``assign_clusters_for_poly_epo_cot_hook`` in train.objective_poly_epo.
+
+    For ``cluster_source=judge``, the ray_trainer dispatch must pass ``data`` in
+    kwargs - see ``infra/patches/maxrl_expose_data_to_adv_est.patch``.
+
+    Returns
+    -------
+    (advantages, advantages) : tuple[torch.Tensor, torch.Tensor]
+        Both tensors have shape ``[batch, response_length]``.
+    """
+    from train.objective_minority import (
+        N_ROLLOUTS,
+        _group_rewards_by_index,
+        _scatter_advantages_to_tokens,
+    )
+    from train.objective_poly_epo import (
+        _poly_epo_cot_advantages,
+        assign_clusters_for_poly_epo_cot_hook,
+    )
+
+    with torch.no_grad():
+        rewards_grouped, problem_ids = _group_rewards_by_index(
+            token_level_rewards, response_mask, index, n_rollouts=N_ROLLOUTS
+        )
+
+        asg = assign_clusters_for_poly_epo_cot_hook(
+            problem_ids=problem_ids,
+            n_rollouts=N_ROLLOUTS,
+            config=config,
+            data=kwargs.get("data"),
+        )
+
+        adv_out = _poly_epo_cot_advantages(rewards_grouped, asg.cluster_ids)
+
         token_adv = _scatter_advantages_to_tokens(
             adv_out.advantages, index, response_mask
         )
